# Prevent direct web access to sensitive PHP config or env files
<FilesMatch "^(config\.php|\.env|.*\.log|rate_limit_.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory browsing
Options -Indexes
