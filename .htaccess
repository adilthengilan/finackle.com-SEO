<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. DO NOT REWRITE API REQUESTS - Allow PHP to execute directly
    RewriteRule ^api/ - [L]

    # 2. DO NOT REWRITE EXISTING FILES OR DIRECTORIES
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. SPA FALLBACK FOR REACT (if non-existent route is requested)
    RewriteRule ^ index.html [L]
</IfModule>

# Security: Deny direct access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
